{
  "name": "aa_erp_api",
  "version": "0.0.0",
  "private": true,
  "main": "app.js",
  "scripts": {
    "clean": "rm -rf build && mkdir build",
    "start": "node build/app.js",
    "dev": "nodemon --exec babel-node src/app.js",
    "build-server": "babel src --out-dir build --copy-files --source-maps",
    "build": "npm run clean && npm run build-server",
    "install-windows-service": "winser -i",
    "uninstall-windows-service": "winser -r",
    "migrate": "node run-migrations.js",
    "migrate:undo": "node run-migrations.js --undo",
    "migrate:single": "node scripts/run-single-migration.js",
    "test:firs": "node scripts/test-firs-einvoicing.js",
    "test:firs:remote": "FIRS_TEST_BASE_URL=https://server.brainstorm.ng/flowbooks FIRS_TEST_SHOW_SECRET=1 node scripts/test-firs-einvoicing.js"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.14.0",
    "cluster": "^0.7.7",
    "config": "^3.3.1",
    "connect-ensure-login": "^0.1.1",
    "cookie-parser": "~1.4.3",
    "core-js": "^3.39.0",
    "cors": "^2.8.4",
    "crypto": "^1.0.1",
    "cuid": "^2.1.8",
    "debug": "~2.6.9",
    "dotenv": "^16.5.0",
    "ejs": "^2.7.1",
    "express": "^4.16.4",
    "express-rate-limit": "^7.5.1",
    "express-status-monitor": "^1.2.8",
    "helmet": "^8.1.0",
    "http": "0.0.0",
    "http-auth": "^3.2.4",
    "http-errors": "~1.6.2",
    "intuit-oauth": "^4.2.3",
    "jade": "~1.11.0",
    "joi": "^17.13.3",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^8.5.1",
    "mailtrap": "^4.1.0",
    "moment": "^2.24.0",
    "morgan": "~1.9.0",
    "multer": "^1.4.2",
    "multer-storage-cloudinary": "^4.0.0",
    "mysql": "^2.15.0",
    "mysql2": "^2.3.3",
    "nano": "^8.2.2",
    "nanoid": "^5.1.5",
    "node-cron": "^4.6.0",
    "node-hl7": "^0.1.3",
    "node-toobusy": "^0.6.3",
    "nodemailer": "^6.10.1",
    "papaparse": "^5.5.3",
    "passport": "^0.4.0",
    "passport-jwt": "^4.0.0",
    "passport-local": "^1.0.0",
    "pdf-parse": "^1.1.1",
    "pdf2json": "^3.1.6",
    "pdf2table": "^0.0.2",
    "request": "^2.88.2",
    "rotating-file-stream": "^2.0.1",
    "sequelize": "^5.18.1",
    "socket.io-client": "^3.1.0",
    "swagger": "^0.7.5",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^3.49.0",
    "uuid": "^3.4.0",
    "uuidv4": "^6.0.0",
    "validator": "^11.1.0",
    "winser": "^1.0.3",
    "winston": "^3.2.1"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.3",
    "@babel/core": "^7.28.5",
    "@babel/node": "^7.27.1",
