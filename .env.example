# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=inventory_db
DB_USER=root
DB_PASSWORD=your_password
DB_DIALECT=mysql

# Server Configuration
NODE_ENV=development
PORT=5000

# Express trust proxy — required behind reverse proxies so req.secure is reliable.
TRUST_PROXY=1
# TRUST_PROXY_IPS=10.0.0.1,127.0.0.1

# Extra browser origins allowed by CORS (comma-separated). Defaults already include
# app/connect/marketspace.aa_erp.org. Add any other frontends here.
# CORS_ALLOWED_ORIGINS=https://connect.aa_erp.org,https://app.aa_erp.org

# Public ERP frontend origin used in password-reset and verification emails.
PUBLIC_FRONTEND_URL=https://ashiru-ali.com
KYC_FRONTEND_URL_DEV=https://ashiru-ali.com
KYC_FRONTEND_URL_PROD=https://ashiru-ali.com

# Admin key for POST /api/kyc/complete (issues PRODUCTION e-invoicing credentials).
# Minimum 24 characters in production; API-key auth is disabled if shorter or unset.
# Prefer header X-KYC-Admin-Key. Admin/superadmin user JWTs are also accepted.
KYC_ADMIN_API_KEY=your_kyc_admin_api_key_min_24_chars_here

# JWT signing secret (required in production, >=16 chars). Prefer JWT_SECRET_KEY.
JWT_SECRET_KEY=your_jwt_secret_key_here_min_16_chars
# Dedicated e-invoicing access-token secret (falls back to JWT_SECRET_KEY if unset).
# EINVOICING_JWT_SECRET=
# Legacy alias (avoid — passport/e-invoicing expect JWT_SECRET_KEY):
# JWT_SECRET=

# Temporary migration compatibility. When "true", legacy PLAINTEXT OTP/reset/
# verification tokens are accepted once (for rows created before hashing).
# Keep FALSE (default) in production; enable only during data migration, then
# remove the compatibility code once all rows are hashed.
KYC_ALLOW_LEGACY_PLAINTEXT=false

# Cloudinary (required for image uploads — never commit real secrets to git)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Status monitor (disabled unless all set; use strong credentials)
# STATUS_MONITOR_ENABLED=true
# STATUS_MONITOR_USER=
# STATUS_MONITOR_PASSWORD=

# Mailtrap Sending API (password reset, KYC, CRM). Must be a Sending token, not Email Testing.
MAILTRAP_TOKEN=your_mailtrap_sending_api_token
# Must be an address on the verified Mailtrap sending domain
MAIL_FROM=noreply@ashiru-ali.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-gmail@gmail.com
# SMTP_PASS=your-gmail-app-password

# BulkSMS Nigeria v2 API (Bearer-token auth) — used for phone OTP delivery.
# Generate a token at bulksmsnigeria.com > API settings.
BULKSMS_API_BASE=https://www.bulksmsnigeria.com/api/v2
BULKSMS_API_TOKEN=771|t20wcUQqT3j7j5r10LLWd2kRldNkexBYf3dxFWlHe22daa7a
BULKSMS_SENDER_ID=AA_ERP
# Prefer corporate/DND route for OTP (account must have this gateway enabled)
BULKSMS_OTP_GATEWAY=direct-corporate
# Optional Twilio fallback for OTP if BulkSMS fails
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# Google reCAPTCHA Enterprise (KYC Connect)
# Site key + Google Cloud project ID + API key (reCAPTCHA Enterprise API enabled)
RECAPTCHA_SITE_KEY=6Ldf3VYtAAAAAMxmYkjH0Ef_lUXSRTBwUFRzJT-Z
RECAPTCHA_PROJECT_ID=your_gcp_project_id
RECAPTCHA_API_KEY=your_gcp_api_key
# RECAPTCHA_SCORE_THRESHOLD=0.5
# Classic fallback only if Enterprise vars above are unset:
# RECAPTCHA_SECRET_KEY=

# API Configuration
API_PREFIX=/api/v1

# FIRS / NRS E-Invoicing (OAuth Bearer — NOT SystemSpecs secretKey)
# Auth: POST /api/v1/invoice/oauth/token  →  Authorization: Bearer <access_token>
# Docs: https://einvoice.firs.gov.ng/docs/introduction?version=1.1
#
# Optional: upstream APP host. When unset, AA ERP accepts invoices locally (SI sandbox).
# FIRS_EINVOICE_BASE_URL=
NRS_BUSINESS_ID=your_nrs_business_uuid
NRS_SERVICE_ID=your_nrs_service_id
NRS_SUPPLIER_TIN=your_brainstorm_tin
NRS_CUSTOMER_TIN=your_customer_tin

# E-invoicing credentials are issued PER BUSINESS and stored (hashed) in the
# einvoicing_clients table — auto-generated on business registration and
# rotatable via POST /api/v1/invoice/credentials/rotate.
#
# Optional global OAuth client (internal tooling / local tests). Leave blank to
# rely solely on per-business credentials.
# OAuth 2.0 identity host shown in the docs/Postman collection. Must be the
# public origin (+ base path) that actually serves the token endpoint
# POST /api/v1/invoice/oauth/token.
EINVOICING_AUTH_BASE_URL=https://server.brainstorm.ng/aa_erp
EINVOICING_OAUTH_CLIENT_ID=
EINVOICING_OAUTH_CLIENT_SECRET=
EINVOICING_OAUTH_TOKEN_TTL=3600
# Docs-only sandbox credentials (never use live EINVOICING_OAUTH_* values here).
# EINVOICING_DOCS_CLIENT_ID=
# EINVOICING_DOCS_CLIENT_SECRET=
# Set true to print docs-only client_id/client_secret in /e-invoicing-api-docs curl samples.
EINVOICING_DOCS_SHOW_SANDBOX_CREDS=false
# Docs samples use NRS_* when both NRS_BUSINESS_ID and NRS_SERVICE_ID are set.
# Set to false to force YOUR_* placeholders; true to force real IDs even if unset.
# EINVOICING_DOCS_USE_REAL_SANDBOX_IDS=false
# Allow user JWT on e-invoicing invoice APIs (dev/UI helper only — keep false in production).
EINVOICING_ALLOW_USER_JWT=false
# Short-lived access-token lifetime is controlled by EINVOICING_OAUTH_TOKEN_TTL.
# (Consider 900 = 15 min so rotated/revoked clients lose access sooner.)
# Set to "true" ONLY for local non-HTTPS testing (never in production):
# EINVOICING_ALLOW_INSECURE=false
#
# Max token requests per IP per 15-minute window (brute-force protection).
EINVOICING_OAUTH_RATE_MAX=20
# The optional global fallback client above has NO bound business, so by default
# it is DENIED from acting on any business. Set to "true" only if you explicitly
# want that global client to act across all businesses (e.g. internal tooling).
# EINVOICING_ALLOW_GLOBAL_CLIENT=false

# "Run in Postman" button target (public Postman workspace run-collection URL).
# Get it from Postman: publish the collection to a public workspace, then
# Share > Run in Postman > copy the URL (looks like
# https://god.gw.postman.com/run-collection/<UID>?action=collection%2Ffork&...).
EINVOICING_POSTMAN_RUN_URL=

# Marketplace storefront public URL (used when building /i/:handle links)
# Dev: http://localhost:5173 | Production: https://aa_erp.org
MARKETPLACE_BASE_URL=http://localhost:5173

# TinyURL API (marketplace tiny links)
TINYURL_API_BASE=https://api.tinyurl.com
TINYURL_API_TOKEN=your_tinyurl_api_token_here
QUICKBOOKS_CLIENT_ID=your_intuit_client_id
QUICKBOOKS_CLIENT_SECRET=your_intuit_client_secret
QUICKBOOKS_ENVIRONMENT=sandbox
# Local dev: http://localhost:42843/aa_erp_api/account/quickbooks/callback
# Production: https://server.brainstorm.ng/aa_erp_api/account/quickbooks/callback
QUICKBOOKS_REDIRECT_URI=
